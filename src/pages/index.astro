---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { issueImages } from "../issueImages";

const issues = await Promise.all(
  (await getCollection("issues"))
    .sort((a, b) => b.id.localeCompare(a.id))
    .map(async (issue) => ({
      id: issue.id,
      images: issueImages(issue.body).slice(0, 5),
      h2s: (await render(issue)).headings.filter((h) => h.depth === 2 && h.text)
    }))
);
---

<Layout>
  <link slot="head" rel="preconnect" href="https://miro.medium.com" />
  <link slot="head" rel="preconnect" href="https://i.ytimg.com" />
  <link slot="head" rel="preconnect" href="https://user-images.githubusercontent.com" />
  <header>
    <div class="logo">📰</div>
    <h1>naver/fe-news 뉴스레터</h1>
    <p>
      &copy;
      <a href="https://github.com/naver/fe-news" target="_blank">Naver Corp.</a>
      , 모든 저작권 보유
    </p>
  </header>
  <section>
    <h2>뉴스레터 목록</h2>
    <hr />
    <ul class="issues" role="list">
      {
        issues.map(({ id, images, h2s }) => (
          <li>
            <a href={`/issues/${id}`}>
              <div data-slides>
                📰
                {images.map((src, k) => (
                  <img
                    src={k === 0 ? src : undefined}
                    data-src={k > 0 ? src : undefined}
                    alt=""
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    class={k > 0 ? "off" : undefined}
                  />
                ))}
              </div>
              <div>
                <time datetime={id}>{id}</time>
                <div class="issue-summary">
                  {h2s.slice(0, 3).map((h2) => (
                    <span>
                      &quot;{h2.text}&quot; <br />
                    </span>
                  ))}
                  ... 외 {Math.max(h2s.length - 3, 0)}개의 주제
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<script>
  const load = (img: HTMLImageElement) => {
    if (img.dataset.src) {
      img.src = img.dataset.src;
      delete img.dataset.src;
    }
  };
  document.addEventListener(
    "error",
    (e) => {
      const img = e.target as HTMLImageElement;
      if (img.tagName !== "IMG") return;
      const p = img.parentElement!;
      const visible = !img.classList.contains("off");
      img.remove();
      const next = p.querySelector("img");
      if (visible && next) {
        load(next);
        next.classList.remove("off");
      }
    },
    true
  );
  for (const box of document.querySelectorAll("[data-slides]")) {
    let i = 0;
    let timer: ReturnType<typeof setInterval>;
    const show = (n: number) => {
      const imgs = box.querySelectorAll("img");
      if (!imgs.length) return;
      i = n % imgs.length;
      imgs.forEach((img, k) => img.classList.toggle("off", k !== i));
    };
    const row = box.closest("a")!;
    row.addEventListener("mouseenter", () => {
      box.querySelectorAll("img").forEach(load);
      show(i + 1);
      timer = setInterval(() => show(i + 1), 1200);
    });
    row.addEventListener("mouseleave", () => {
      clearInterval(timer);
      show(0);
    });
  }
</script>
