---
import "../styles/globals.css";

const {
  title = "naver/fe-news 뉴스레터 뷰어 (비공식)",
  ogTitle = "naver/fe-news 뉴스레터",
  description = "네이버 FE 뉴스레터(naver/fe-news)를 읽기 편하게 볼 수 있는 뷰어",
  image,
  type = "website"
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="naver/fe-news 뉴스레터" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/icon-512x512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="speculationrules" is:inline>
      {"prerender":[{"where":{"href_matches":["/","/issues/*"]},"eagerness":"moderate"}]}
    </script>
    <slot name="head" />
  </head>
  <body>
    <main>
      <slot />
      <hr />
    </main>
    <footer>
      <p>
        Naver Corp.와는 어떠한 관련이 없는 비공식 뷰어입니다. &copy;
        <a href="https://github.com/naver/fe-news" target="_blank">
          Naver Corp.
        </a>
        , 모든 저작권 보유
      </p>
      <p>
        뷰어 소스코드:{" "}
        <a
          href="https://github.com/atjsh/naver-fe-news-viewer"
          target="_blank"
        >
          https://github.com/atjsh/naver-fe-news-viewer
        </a>
      </p>
    </footer>
  </body>
</html>
