---
import "../styles/globals.css";

const { title = "naver/fe-news 뉴스레터 뷰어 (비공식)" } = Astro.props;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📰</text></svg>"
    />
  </head>
  <body class=" dark:bg-black dark:text-white">
    <main class=" max-w-xl p-3 m-auto mt-20 mb-4">
      <slot />
      <hr class=" my-4" />
    </main>
    <footer class=" text-center text-zinc-500 mb-7">
      <p>
        Naver Corp.와는 어떠한 관련이 없는 비공식 뷰어입니다. &copy;
        <a href="https://github.com/naver/fe-news" class=" underline" target="_black">
          Naver Corp.
        </a>
        , 모든 저작권 보유
      </p>
      <p>
        뷰어 소스코드:{" "}
        <a
          href="https://github.com/ATJSH/naver-fe-news-viewer"
          class="underline"
          target="_black"
        >
          ATJSH/naver-fe-news-viewer
        </a>
      </p>
    </footer>
  </body>
</html>
