---
import type { MarkdownHeading } from "astro";

type TocNode = MarkdownHeading & { children: TocNode[] };
interface Props {
  items: TocNode[];
  class?: string;
}

const { items, class: cls } = Astro.props;
---

<ul class={cls}>
  {
    items.map((h) => (
      <li>
        <a href={`#${h.slug}`}>{h.text}</a>
        {h.children.length > 0 && <Astro.self items={h.children} />}
      </li>
    ))
  }
</ul>
